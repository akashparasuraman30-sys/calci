import tkinter as tk


class Calculator:
    def __init__(self, root):
        self.root = root
        root.title("Calculator")
        root.geometry("320x460")
        root.resizable(False, False)
        root.configure(bg="#1e1e1e")

        self.expression = ""
        self.display_var = tk.StringVar(value="0")

        display = tk.Entry(
            root, textvariable=self.display_var, font=("Segoe UI", 28),
            bd=0, bg="#1e1e1e", fg="white", justify="right",
            readonlybackground="#1e1e1e", state="readonly",
        )
        display.pack(fill="x", padx=15, pady=(25, 10), ipady=10)

        frame = tk.Frame(root, bg="#1e1e1e")
        frame.pack(expand=True, fill="both", padx=10, pady=10)

        buttons = [
            ["C", "⌫", "%", "/"],
            ["7", "8", "9", "*"],
            ["4", "5", "6", "-"],
            ["1", "2", "3", "+"],
            ["±", "0", ".", "="],
        ]

        for r, row in enumerate(buttons):
            frame.rowconfigure(r, weight=1)
            for c, label in enumerate(row):
                frame.columnconfigure(c, weight=1)
                if label == "=":
                    bg = "#ff9500"
                elif label in "/*-+%":
                    bg = "#3a3a3c"
                elif label in ("C", "⌫", "±"):
                    bg = "#505050"
                else:
                    bg = "#2c2c2e"
                tk.Button(
                    frame, text=label, font=("Segoe UI", 16),
                    bg=bg, fg="white", activebackground="#666",
                    activeforeground="white", bd=0, relief="flat",
                    command=lambda x=label: self.on_click(x),
                ).grid(row=r, column=c, sticky="nsew", padx=3, pady=3)

        root.bind("<Key>", self.on_key)
        root.bind("<Return>", lambda e: self.on_click("="))
        root.bind("<BackSpace>", lambda e: self.on_click("⌫"))
        root.bind("<Escape>", lambda e: self.on_click("C"))

    def on_key(self, event):
        if event.char in "0123456789.+-*/%":
            self.on_click(event.char)

    def update(self):
        self.display_var.set(self.expression or "0")

    def on_click(self, key):
        if key == "C":
            self.expression = ""
        elif key == "⌫":
            self.expression = self.expression[:-1]
        elif key == "±":
            if self.expression.startswith("-"):
                self.expression = self.expression[1:]
            elif self.expression:
                self.expression = "-" + self.expression
        elif key == "=":
            self.calculate()
            return
        else:
            self.expression += key
        self.update()

    def calculate(self):
        try:
            expr = self.expression.replace("%", "/100")
            result = eval(expr, {"__builtins__": {}}, {})
            if isinstance(result, float) and result.is_integer():
                result = int(result)
            self.expression = str(round(result, 10)) if isinstance(result, float) else str(result)
        except ZeroDivisionError:
            self.expression = ""
            self.display_var.set("Cannot divide by 0")
            return
        except Exception:
            self.expression = ""
            self.display_var.set("Error")
            return
        self.update()


if __name__ == "__main__":
    root = tk.Tk()
    Calculator(root)
    root.mainloop()
